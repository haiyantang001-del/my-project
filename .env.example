# ===========================================
# CRM 系统生产环境配置
# ===========================================
# 复制此文件为 .env.production 并修改配置

# 服务端口
PORT=3000

# 环境
NODE_ENV=production

# 数据库连接 (请修改为您的数据库地址)
# 阿里云 RDS PostgreSQL 或容器内数据库
DATABASE_URL=postgresql://postgres:Tencent2025@postgres:5432/genie?schema=public

# JWT 密钥 (请修改为随机字符串)
JWT_SECRET=your-secure-jwt-secret-key-change-me

# CORS 允许的域名 (生产环境建议指定具体域名)
CORS_ORIGIN=*

# API 前缀
API_PREFIX=/api
